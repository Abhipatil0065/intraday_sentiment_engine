# ===========================================================================
# Intraday News Sentiment & Market Impact Engine - Example configuration
# Copy to `.env` and edit.   NEVER commit the real `.env`.
# ===========================================================================

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/engine.log

# SQLite for local dev. Use postgresql+psycopg://user:pass@host/db in prod.
DATABASE_URL=sqlite:///./data/intraday_sentiment.db

# ---------------------------------------------------------------------------
# TIMEZONES  (IMPORTANT - drives the "TODAY ONLY" filter)
# MARKET_TIMEZONE decides what "today" means for the news filter.
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=America/New_York
DISPLAY_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# LLM PROVIDER  (any OpenAI-compatible endpoint)
# Leave LLM_API_KEY empty to run in DETERMINISTIC HEURISTIC MODE.
# The engine never fabricates data; heuristic mode is clearly flagged in the
# dashboard output so you always know which mode produced a sentiment.
# Verify your key any time with:  python run.py --check-llm
# ---------------------------------------------------------------------------

# === OPTION A: NVIDIA NIM (OpenAI-compatible) ============================
# Get a key: https://build.nvidia.com  ->  Get API Key
# NOTE: NVIDIA has RETIRED all DeepSeek models (EOL 2026-08-07).
# Verified-live models:
#   nvidia/nemotron-3-super-120b-a12b    <- recommended balance
#   nvidia/nemotron-3-ultra-550b-a55b    <- most capable
#   nvidia/nemotron-3.5-lightning-30b-a3b<- fastest / cheapest
#   moonshotai/kimi-k3
#   z-ai/glm-5.3
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# === OPTION B: DeepSeek direct ===========================================
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# === OPTION C: any other OpenAI-compatible provider ======================
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=deepseek/deepseek-chat
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen2.5:14b
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT=4
# Hard cap on requests per rolling minute, counted per HTTP attempt (retries
# included). A request over budget waits for a slot instead of getting a 429.
# 0 disables the limiter. 40/min suits an NVIDIA NIM free-tier key.
LLM_REQUESTS_PER_MINUTE=40
LLM_MAX_TOKENS=3000
# Set false if your endpoint rejects response_format={"type":"json_object"}
LLM_JSON_MODE=true
LLM_ENABLED=true
# INGESTION SCHEDULER
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=180
ARTICLE_FETCH_ENABLED=true
ARTICLE_FETCH_MAX_CHARS=4000
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36

# Set true to demo the whole engine offline with synthetic news (no network).
USE_MOCK_SOURCE=false

# ---------------------------------------------------------------------------
# TODAY-ONLY FILTER
# Anything older than this many hours is rejected even if "dated today".
# ---------------------------------------------------------------------------
MAX_ARTICLE_AGE_HOURS=26
# An article is considered an UPDATE (not a new event) if the publisher bumped
# it within this many hours of its original publication.
UPDATE_WINDOW_HOURS=6

# ---------------------------------------------------------------------------
# EVENT DEDUPLICATION
# ---------------------------------------------------------------------------
DEDUP_SIMILARITY_THRESHOLD=0.72
DEDUP_TIME_WINDOW_HOURS=12

# ---------------------------------------------------------------------------
# PRICE-ACTION CONFIRMATION (optional, section 12)
# Disabled by default. When enabled, failures degrade to
# "Price-action confirmation unavailable." - never invented data.
# ---------------------------------------------------------------------------
PRICE_DATA_ENABLED=false
PRICE_API_BASE_URL=https://api.coinbase.com/v2

# ---------------------------------------------------------------------------
# ALERTS
# Emit an alert when importance is VERY HIGH or impact strength is VERY HIGH.
# ---------------------------------------------------------------------------
ALERT_ON_IMPORTANCE=VERY_HIGH
ALERT_ON_STRENGTH=VERY_HIGH

# ---------------------------------------------------------------------------
# NEWS SOURCES  (fully pluggable)
# format: name|type|url|weight|quality_tier  -- entries separated by commas.
# type: rss | atom | html | kitco | fj | mock
# quality_tier: TIER_1_OFFICIAL | TIER_2_MAJOR | TIER_3_CRYPTO | TIER_4_OTHER
# NOTE: keep this on ONE line - .env parsers do not support multi-line values.
# NOTE: 'CNBC Markets', 'Yahoo Finance' and 'WSJ Markets' are intentionally NOT
#   listed - their free feeds are dead/frozen and served nothing fresh.
#   Probe any candidate feed with `python -m tests.probe_sources` first.
# ---------------------------------------------------------------------------
NEWS_SOURCES=CNBC Economy|rss|https://www.cnbc.com/id/100003114/device/rss/rss.html|1.0|TIER_2_MAJOR, Investing.com|rss|https://www.investing.com/rss/news.rss|0.8|TIER_4_OTHER, CoinDesk|rss|https://www.coindesk.com/arc/outboundfeeds/rss/|0.9|TIER_3_CRYPTO, Cointelegraph|rss|https://cointelegraph.com/rss|0.8|TIER_3_CRYPTO, Financial Juice|fj|https://www.financialjuice.com/|0.9|TIER_2_MAJOR, CNBC Finance|rss|https://www.cnbc.com/id/10000664/device/rss/rss.html|0.9|TIER_2_MAJOR, Reuters|rss|https://news.google.com/rss/search?q=when:1d+site:reuters.com&hl=en-US&gl=US&ceid=US:en|1.0|TIER_2_MAJOR, Bloomberg Markets|rss|https://feeds.bloomberg.com/markets/news.rss|1.0|TIER_2_MAJOR, Kitco|kitco|https://www.kitco.com/news/|1.0|TIER_2_MAJOR, MarketWatch|rss|https://feeds.content.dowjones.io/public/rss/mw_bulletins|0.9|TIER_2_MAJOR

# Additional official / primary sources - append to the line above.
# Federal Reserve|rss|https://www.federalreserve.gov/feeds/press_all.xml|1.2|TIER_1_OFFICIAL
# BLS Releases|rss|https://www.bls.gov/feed/bls_latest.rss|1.2|TIER_1_OFFICIAL
# Treasury|rss|https://home.treasury.gov/rss/press.xml|1.2|TIER_1_OFFICIAL
# SEC News|rss|https://www.sec.gov/news/pressreleases.rss|1.2|TIER_1_OFFICIAL

# ---------------------------------------------------------------------------
# MARKET ASSETS  (the three supported assets - do not add others)
# ---------------------------------------------------------------------------
ASSETS=XAUUSD,XAGUSD,BTCUSD

# ---------------------------------------------------------------------------
# ECONOMIC CALENDAR (weighed into the bullish/bearish verdict)
# Keyless public feed - no API key required. Failures are non-fatal.
# Set ENABLED=false to run news-only.
# ---------------------------------------------------------------------------
ECONOMIC_CALENDAR_ENABLED = true
ECONOMIC_CALENDAR_URL = https://nfs.faireconomy.media/ff_calendar_thisweek.json
# Optional second feed (this provider 404s on nextweek, so it is off by default)
ECONOMIC_CALENDAR_NEXTWEEK_URL =
# LOW / MEDIUM / HIGH - Low prints are filler and are dropped
ECONOMIC_CALENDAR_MIN_IMPORTANCE = MEDIUM
# How far ahead an upcoming release may influence MARKET PREP
ECONOMIC_CALENDAR_HORIZON_HOURS = 48

# ---------------------------------------------------------------------------
# DASHBOARD
# ---------------------------------------------------------------------------
DASHBOARD_PORT=8501
API_HOST=127.0.0.1
API_PORT=8000

