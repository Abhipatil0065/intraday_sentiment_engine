# ===========================================================================
# Intraday News Sentiment & Market Impact Engine - Example configuration
# Copy to `.env` and edit.   NEVER commit the real `.env`.
# ===========================================================================

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/engine.log

# SQLite for local dev. Use postgresql+psycopg://user:pass@host/db in prod.
DATABASE_URL=sqlite:///./data/intraday_sentiment.db

# ---------------------------------------------------------------------------
# TIMEZONES  (IMPORTANT - drives the "TODAY ONLY" filter)
# MARKET_TIMEZONE decides what "today" means for the news filter.
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=America/New_York
DISPLAY_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# LLM PROVIDER  (any OpenAI-compatible endpoint)
# Leave LLM_API_KEY empty to run in DETERMINISTIC HEURISTIC MODE.
# The engine never fabricates data; heuristic mode is clearly flagged in the
# dashboard output so you always know which mode produced a sentiment.
# Verify your key any time with:  python run.py --check-llm
# ---------------------------------------------------------------------------

# === OPTION A: NVIDIA NIM (OpenAI-compatible) ============================
# Get a key: https://build.nvidia.com  ->  Get API Key
# NOTE: NVIDIA has RETIRED all DeepSeek models (EOL 2026-08-07).
# NOTE: nvidia/nemotron-3-super-120b-a12b is RETIRED (HTTP 410 Gone).
# Verified-live against GET /v1/models on 2026-10-03. Most catalogue entries
# return 404 on /chat/completions for a personal key; these two were confirmed
# to serve real requests and return schema-valid JSON for this engine:
#   nvidia/nemotron-3-ultra-550b-a55b     <- default, most capable
#   nvidia/nemotron-3.5-lightning-30b-a3b <- faster, but less schema-reliable
# The endpoint returns intermittent 503s regardless of request rate (server
# capacity, not rate limiting); the client retries these and falls back to the
# deterministic heuristic classifier if all attempts fail.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# === OPTION B: DeepSeek direct ===========================================
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# === OPTION C: any other OpenAI-compatible provider ======================
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=deepseek/deepseek-chat
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen2.5:14b
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CONCURRENT=2
# Hard cap on requests per rolling minute, counted per HTTP attempt (retries
# included). A request over budget waits for a slot instead of getting a 429.
# 0 disables the limiter. 40/min suits an NVIDIA NIM free-tier key.
LLM_REQUESTS_PER_MINUTE=40
LLM_MAX_TOKENS=3000
# Set false if your endpoint rejects response_format={"type":"json_object"}
LLM_JSON_MODE=true
LLM_ENABLED=true
# INGESTION SCHEDULER
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=180
ARTICLE_FETCH_ENABLED=true
ARTICLE_FETCH_MAX_CHARS=4000
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36

# Set true to demo the whole engine offline with synthetic news (no network).
USE_MOCK_SOURCE=false

# ---------------------------------------------------------------------------
# ROLLING NEWS WINDOW  (replaces the old "same NY calendar date" gate)
# Admit news on RECENCY rather than on which calendar day it landed in.
# This is why the overnight US wrap no longer needs a special date carve-out.
# Set to 0 to judge on MAX_ARTICLE_AGE_HOURS alone.
# ---------------------------------------------------------------------------
NEWS_WINDOW_HOURS=18.0
# Hard cap on article age, independent of the window.
MAX_ARTICLE_AGE_HOURS=26
# Age within which a signal counts toward the "changed in last 60 min" delta.
DELTA_WINDOW_MINUTES=60
# Days of news kept in the DB, counted in MARKET_TIMEZONE.
# 2 = keep today + the previous day; anything older is deleted automatically on
# every pipeline pass. Set 0 to keep everything forever.
NEWS_RETENTION_DAYS=2
# An article is considered an UPDATE (not a new event) if the publisher bumped
# it within this many hours of its original publication.
UPDATE_WINDOW_HOURS=6

# ---------------------------------------------------------------------------
# BIAS / NO_BIAS THRESHOLDS
# A direction is published only when BOTH the score and the confidence clear
# their floor. Below either one the engine answers NO_BIAS.
# ---------------------------------------------------------------------------
BIAS_MIN_ABS_SCORE=12.0
BIAS_MIN_CONFIDENCE=0.30

# ---------------------------------------------------------------------------
# EVENT CLUSTERING + CORROBORATION
# A cluster counts as ONE event. Extra INDEPENDENT sources add only a small
# capped boost, so five outlets on one FOMC decision cannot cast five votes.
# ---------------------------------------------------------------------------
DEDUP_SIMILARITY_THRESHOLD=0.72
DEDUP_TIME_WINDOW_HOURS=12
CORROBORATION_PER_SOURCE=0.10
CORROBORATION_MAX_BOOST=0.30

# ---------------------------------------------------------------------------
# TEXT QUALITY
# ---------------------------------------------------------------------------
# Token distance within which a subject and verb count as related. Replaces the
# old fixed 24-CHARACTER window, which broke on long phrasing.
INVERSION_MAX_TOKENS=8
NEGATION_WINDOW_TOKENS=4
# A headline that merely REPORTS a move ("gold plunges 2%") gets this weight.
PRICE_ACTION_WEIGHT=0.10
PRICED_IN_MULTIPLIER=0.45
PRICED_IN_FLOOR=0.25
SURPRISE_MULTIPLIER=1.35
HEDGE_MULTIPLIER=0.70
HEDGE_FLOOR=0.35

# ---------------------------------------------------------------------------
# CATEGORY-SPECIFIC DECAY HALF-LIVES (hours)
# SUPERSEDED (Task 5a, retuned 2026-10-13): decay now runs on the per-event-tier
# table TIER_HALF_LIVES (GOLD~1.5h / TIER_2~0.75h / TIER_3~0.25h) scaled per
# asset by ASSET_DECAY_MULTIPLIER (app/config.py; see
# sentiment_engine.decay_weight). Nothing in the scoring path reads the two
# fields below - they are kept only so old .env files still parse.
# ---------------------------------------------------------------------------
DECAY_DEFAULT_HOURS=6.0
DECAY_HALF_LIVES=Central Bank=3.0,Interest Rates=3.0,Inflation=3.0,Employment=3.0,Treasury Yields=4.0,USD/DXY=5.0,GDP=6.0,Banking/Financial Stress=8.0,Geopolitics=8.0,Risk Sentiment=5.0,ETF Flows=24.0,Bitcoin ETF Flows=24.0,Crypto Market Flows=12.0,Crypto Regulation=72.0,China=12.0,Industrial Demand=12.0,Commodity Supply/Demand=10.0,Oil/Energy=8.0,Equities=8.0,Other=6.0

# ---------------------------------------------------------------------------
# DECISION LOG (audit trail for tuning)
# Every article classification and published bias is appended here. Use
#   python tools/hitrate_report.py --prices data/<asset>.csv
# to score the log against realised prices by confidence bucket.
# ---------------------------------------------------------------------------
DECISION_LOG_PATH=logs/decisions.jsonl

# ---------------------------------------------------------------------------
# PRICE-ACTION CONFIRMATION (optional, section 12)
# Disabled by default. When enabled, failures degrade to
# "Price-action confirmation unavailable." - never invented data.
# BTC comes from Coinbase (PRICE_API_BASE_URL); GOLD/SILVER have no spot
# feed, so they always read unavailable.
# ---------------------------------------------------------------------------
PRICE_DATA_ENABLED=false
PRICE_API_BASE_URL=https://api.coinbase.com/v2

# ---------------------------------------------------------------------------
# ALERTS
# Emit an alert when importance is VERY HIGH or impact strength is VERY HIGH.
# ---------------------------------------------------------------------------
ALERT_ON_IMPORTANCE=VERY_HIGH
ALERT_ON_STRENGTH=VERY_HIGH

# ---------------------------------------------------------------------------
# TRADINGVIEW NEWS (primary: direct API)
# 
# PRIMARY: TradingView API (kind=tradingview_api) - uses news-mediator.tradingview.com
#   No API token required. Returns full timestamps, provider, related symbols.
#   Add to NEWS_SOURCES:
#     TradingView API News|tradingview_api|https://www.tradingview.com/news/|1.0|TIER_1_PRIMARY
#     TradingView Equity News|tradingview_api|https://www.tradingview.com/news/|1.0|TIER_1_PRIMARY
#
# Symbol mapping override (optional): "XAUUSD=FX_IDC:XAUUSD,BTCUSD=BITSTAMP:BTCUSD"
# ---------------------------------------------------------------------------
TRADINGVIEW_SYMBOL_MAP=

# ---------------------------------------------------------------------------
# NEWS SOURCES  (fully pluggable)
# format: name|type|url|weight|quality_tier  -- entries separated by commas.
# type: rss | atom | html | kitco | fj | mock
# quality_tier: TIER_1_OFFICIAL | TIER_2_MAJOR | TIER_3_CRYPTO | TIER_4_OTHER
# NOTE: keep this on ONE line - .env parsers do not support multi-line values.
# NOTE: 'CNBC Markets', 'Yahoo Finance' and 'WSJ Markets' are intentionally NOT
#   listed - their free feeds are dead/frozen and served nothing fresh.
#   Probe any candidate feed with `python -m tests.probe_sources` first.
# ---------------------------------------------------------------------------
NEWS_SOURCES=CNBC Economy|rss|https://www.cnbc.com/id/100003114/device/rss/rss.html|1.0|TIER_2_MAJOR, Investing.com|rss|https://www.investing.com/rss/news.rss|0.8|TIER_4_OTHER, CoinDesk|rss|https://www.coindesk.com/arc/outboundfeeds/rss/|0.9|TIER_3_CRYPTO, Financial Juice|fj|https://www.financialjuice.com/|0.9|TIER_2_MAJOR, CNBC Finance|rss|https://www.cnbc.com/id/10000664/device/rss/rss.html|0.9|TIER_2_MAJOR, Reuters|rss|https://news.google.com/rss/search?q=when:1d+site:reuters.com&hl=en-US&gl=US&ceid=US:en|1.0|TIER_2_MAJOR, Bloomberg Markets|rss|https://feeds.bloomberg.com/markets/news.rss|1.0|TIER_2_MAJOR, Kitco|kitco|https://www.kitco.com/news/|1.0|TIER_2_MAJOR, MarketWatch|rss|https://feeds.content.dowjones.io/public/rss/mw_bulletins|0.9|TIER_2_MAJOR, Fed Press Releases|rss|https://www.federalreserve.gov/feeds/press_all.xml|1.2|TIER_1_OFFICIAL, FXStreet|rss|https://www.fxstreet.com/rss|1.0|TIER_2_MAJOR, Benzinga|rss|https://news.google.com/rss/search?q=when:1d+site:benzinga.com&hl=en-US&gl=US&ceid=US:en|0.9|TIER_2_MAJOR, FT Markets|rss|https://news.google.com/rss/search?q=when:1d+site:ft.com+markets&hl=en-US&gl=US&ceid=US:en|1.0|TIER_2_MAJOR, Kitco Metals|rss|https://news.google.com/rss/search?q=when:1d+site:kitco.com+gold&hl=en-US&gl=US&ceid=US:en|1.0|TIER_2_MAJOR, FXStreet Gold|rss|https://news.google.com/rss/search?q=when:1d+gold+site:fxstreet.com&hl=en-US&gl=US&ceid=US:en|0.9|TIER_2_MAJOR
# Added 2026-10-05 to cover OVERNIGHT and WEEKEND gaps. A source showing STALE in
# `python -m tests.probe_sources` is often just a weekday US publisher with
# nothing from today - probe at 02:00 New York and Kitco/Fed legitimately look
# dead. These run 24/7 or sit in another timezone.
# Note BLS: the direct bls.gov feed returns HTTP 403 to this client on every
# poll, so releases are read through the Google News RSS proxy instead.
# Rejected after probing: ECB/BoE/RBA/Treasury (silent on weekends),
# Mining.com/Northern Miner/Gold-Eagle (stale), CoinJournal (HTTP error).
# Added 2026-10-05. Each was probed LIVE first and had TODAY-dated articles.
# FT Markets has no public feed of its own (ft.com blocks automated clients), so
# it is read through the Google News RSS proxy - same as Reuters/Benzinga above.
# Rejected after probing: CNBC World (19/30 titles duplicate existing CNBC
# feeds), BeInCrypto (served off-topic articles), Kitco RSS (HTTP error).
# See the full probe notes in the project README.

# Official / primary sources that did NOT survive verification (checked live):
# BLS      -> 403 Forbidden via the RssSource Accept header, on every poll.
# Treasury -> /rss/press.xml is 404; /rss.xml works but its newest item is
#             months old, so every article is dropped by the age filter.
# SEC      -> feed resolves, but its newest item was ~38h old - beyond
#             MAX_ARTICLE_AGE_HOURS, so nothing it publishes ever lands.
# ECB      -> resolves with titles only and no body text; low value vs FXStreet.

# ---------------------------------------------------------------------------
# MARKET ASSETS  (the chart feeds the TradingView per-symbol news query runs)
# USOIL is crude oil (WTI), mapped to TVC:USOIL. It is a first-class asset:
# it gets its own snapshot, its own bias history and its own card.
# ---------------------------------------------------------------------------
ASSETS=XAUUSD,XAGUSD,BTCUSD,USOIL

# ---------------------------------------------------------------------------
# ECONOMIC CALENDAR (weighed into the bullish/bearish verdict)
# Keyless public feed - no API key required. Failures are non-fatal.
# Set ENABLED=false to run news-only.
# ---------------------------------------------------------------------------
ECONOMIC_CALENDAR_ENABLED = true
ECONOMIC_CALENDAR_URL = https://nfs.faireconomy.media/ff_calendar_thisweek.json
# Optional second feed (this provider 404s on nextweek, so it is off by default)
ECONOMIC_CALENDAR_NEXTWEEK_URL =
# LOW / MEDIUM / HIGH - Low prints are filler and are dropped
ECONOMIC_CALENDAR_MIN_IMPORTANCE = MEDIUM
# How far ahead an upcoming release may influence MARKET PREP
ECONOMIC_CALENDAR_HORIZON_HOURS = 48
# Does a SCHEDULED print move a card before it happens?
#   false (default) - an upcoming print is a RISK, not evidence. It is listed
#     in the economic-calendar panel and raises the EVENT RISK note, but it
#     adds NO bull/bear weight to any card. A card moves only when the real
#     number is published and the surprise is known.
#   true - the old behaviour: a consensus expectation contributes at reduced
#     persistence and is damped/dropped once it goes stale.
CALENDAR_UPCOMING_CONTRIBUTES = false

# ---------------------------------------------------------------------------
# FINANCIALJUICE CALENDAR (the primary calendar provider)
# A plain-Chromium render of the FJ calendar. It is HEAVY (10-20s) and the
# site is Cloudflare-sensitive, so it has its own cadence instead of being
# re-rendered on every pipeline tick.
# ---------------------------------------------------------------------------
FINANCIALJUICE_CALENDAR_ENABLED = true
# The calendar's own poll interval, in seconds. 0 = poll on every tick.
FJ_CALENDAR_POLL_SECONDS = 600
# Around a HIGH impact release the cadence tightens to FJ_CALENDAR_BURST_SECONDS
# so the actual number is picked up within a tick of the print. The window
# runs from PRE_RELEASE_MINUTES before the release until POST_RELEASE_MINUTES
# after it. (Bounded below by the pipeline tick interval.)
FJ_CALENDAR_PRE_RELEASE_MINUTES = 15
FJ_CALENDAR_POST_RELEASE_MINUTES = 30
FJ_CALENDAR_BURST_SECONDS = 60
# A render below this many rows means the SPA had not hydrated: a FAILED poll,
# never "no events today".
FJ_CALENDAR_MIN_ROWS = 10
# Hard ceiling on one render, wall-clock seconds.
FJ_CALENDAR_TIMEOUT_SECONDS = 40
# Backoff after a detected challenge/block page.
FJ_CALENDAR_BACKOFF_MINUTES = 30
# MUST stay UTC while the context is pinned to UTC - they are two halves of
# one fact, and a mismatch is refused rather than silently skewing timestamps.
FJ_CALENDAR_RENDER_TIMEZONE = UTC

# ---------------------------------------------------------------------------
# REGION WHITELIST FOR THE CALENDAR
# Only the regions listed in app/config/calendar_bias.json may reach the
# sentiment engine (default: USA, Eurozone, China, Japan, UK). The match is
# two-stage: the event's country/currency must belong to a listed region AND
# its title must match that region's event list.
#   true  (default) - only whitelisted regions contribute.
#   false - the previous, unfiltered behaviour, restored exactly. Use it to
#     compare the old verdict against the region-filtered one; the REGIONAL
#     MACRO BIAS panel stays region-scoped either way.
# ---------------------------------------------------------------------------
CALENDAR_REGION_FILTER_ENABLED = true

# ---------------------------------------------------------------------------
# STANDARDISED SURPRISE
# surprise_z = (actual - forecast) / std(indicator). Replacing the old flat 2%
# threshold, which called a 0.2% CPI miss "no surprise" and a 120k payroll miss
# huge. An indicator not listed falls back to SURPRISE_STD_DEFAULT.
# ---------------------------------------------------------------------------
SURPRISE_STD_DEFAULT=1.0
SURPRISE_NEUTRAL_BAND=0.30
SURPRISE_STRONG_BAND=1.00
SURPRISE_STD_TABLE=cpi=0.3,ppi=0.3,core pce=0.2,core cpi=0.2,pce=0.2,inflation=0.3,nonfarm=120.0,nfp=120.0,payroll=120.0,jobless claim=10.0,unemployment rate=0.2,employment change=120.0,fomc=0.5,federal reserve=0.5,rate decision=0.25,ecb=0.25,boe=0.25,boj=0.25,powell=0.5,gdp=0.5,pmi=0.5,ism=0.5,industrial production=0.4,retail sales=0.5,treasury yield=0.15,bond yield=0.15,10-year=0.15,dxy=0.4

# ---------------------------------------------------------------------------
# EVENT RISK
# When a release this important lands this soon, every asset's output carries
# event_risk=true plus a note, because the standing bias is about to be
# overwritten by a print nobody can predict.
# ---------------------------------------------------------------------------
EVENT_RISK_LOOKAHEAD_MINUTES=45
EVENT_RISK_MIN_IMPORTANCE=HIGH

# ---------------------------------------------------------------------------
# DASHBOARD
# ---------------------------------------------------------------------------
DASHBOARD_PORT=8501
API_HOST=127.0.0.1
API_PORT=8000


# ---------------------------------------------------------------------------
# OVERNIGHT CATCH-UP ("MORNING BRIEF")
# The engine only runs while the laptop is on. On the next boot it judges the
# shutdown gap in ONE pass: every headline published while the machine was off
# is sent through the LLM for a HIGH / MEDIUM / LOW impact verdict, the stored
# classification is refreshed, and a dated report is written to
# data/reports/morning_brief_<date>.json.
#
# Register the logon task once (elevated PowerShell):
#   powershell -ExecutionPolicy Bypass -File scripts\register_morning_brief_task.ps1
# Run it by hand:
#   python run.py --morning-brief            (--dry-run to preview, no LLM calls)
# ---------------------------------------------------------------------------
MORNING_BRIEF_ON_BOOT=true
MORNING_BRIEF_MIN_GAP_MINUTES=90
OVERNIGHT_MAX_GAP_HOURS=24
MORNING_BRIEF_WAIT_IDLE_SECONDS=300
MORNING_BRIEF_STARTUP_GRACE_SECONDS=15
